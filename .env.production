# Microsoft Clarity project id, inlined into the client bundle at build time.
#
# This file is committed on purpose. The id is public: it rides in the tag URL
# on every page view. Secrets still belong in .env or .env*.local, both of
# which stay gitignored.
#
# A variable of the same name set in the Cloudflare Pages dashboard overrides
# this file, because Next.js reads process.env before any .env file.
NEXT_PUBLIC_CLARITY_PROJECT_ID=yi6qcw3wdd
